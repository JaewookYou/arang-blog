# =================================
# Site Configuration
# =================================
NEXT_PUBLIC_SITE_URL=https://blog.arang.kr

# =================================
# Auth.js (NextAuth) Configuration
# =================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# GitHub OAuth App
# Create at: https://github.com/settings/developers
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# Allowed admin users (comma-separated GitHub usernames)
ADMIN_WHITELIST=JaewookYou

# =================================
# Git-CMS Configuration
# =================================
# Personal Access Token with 'repo' scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-personal-access-token

# Repository info (defaults to JaewookYou/arang-blog)
GITHUB_REPO_OWNER=JaewookYou
GITHUB_REPO_NAME=arang-blog

# =================================
# Database Configuration
# =================================
# Optional: custom SQLite database path
# DB_PATH=/path/to/blog.db

# =================================
# AI Translation (Gemini)
# =================================
# Gemini API Key for AI translation
# Get at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: translation models, tried in order (default: gemini-3.8-flash,gemini-flash-latest,gemini-2.5-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: set to false to disable automatic translation on server start / every 6 hours
# AUTO_TRANSLATE=true

# Token for internal scripts (/api/internal/translate, /api/internal/translations/sync)
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=your-internal-api-token
